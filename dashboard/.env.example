# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://dujhgnnphqmcskfpbmll.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_G-EWUU_c0ttpQC59P4VhfA_EBlJkORu
# Secret key (sb_secret_…) from Supabase → Project Settings → API Keys. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed dashboard (used for OAuth redirects and links)
NEXT_PUBLIC_APP_URL=https://dashboard.paragraphfilms.com

# Protects /api/cron/* (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# --- Google Calendar + Docs (to-dos, schedule, notebook) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- QuickBooks Online (clients, cash, receivables, P&L) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" to test against an Intuit sandbox company; leave empty for the real books
QBO_ENV=
# 32-byte base64 key that encrypts the stored QuickBooks tokens (AES-256-GCM). Generate with: openssl rand -base64 32
# Required for QuickBooks: without it, connecting and syncing fail instead of storing tokens in plain text.
QBO_TOKEN_KEY=

# Set to "true" to publish /privacy and /terms. While unset, both pages return 404.
LEGAL_PAGES_LIVE=

# --- Optional: analytics + film stills ---
VIMEO_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TMDB_API_KEY=
